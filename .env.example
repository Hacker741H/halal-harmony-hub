# Scripts de recette uniquement : ne jamais définir en production.
ALLOW_SECURITY_TEST_USERS=false
SECURITY_TEST_EMAIL_DOMAIN=erp-security-test.invalid
SUPABASE_ANON_KEY=
ALLOW_DOCUMENT_ORPHAN_CLEANUP=false
