# Navigateur / build Vite : valeurs publiques uniquement.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Serveur TanStack Start, scripts administratifs et Edge Functions : secrets.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NOTIFICATION_SCHEDULER_SECRET=

# Connecteur de paiement Jèko : secrets exclusivement serveur / Edge Function.
JEKO_API_KEY=
JEKO_API_KEY_ID=
JEKO_WEBHOOK_SECRET=
JEKO_BASE_URL=

# Scripts de recette uniquement : ne jamais définir en production.
ALLOW_SECURITY_TEST_USERS=false
SECURITY_TEST_EMAIL_DOMAIN=erp-security-test.invalid
SUPABASE_ANON_KEY=
ALLOW_DOCUMENT_ORPHAN_CLEANUP=false
