# Navigateur / build Vite : valeurs publiques uniquement.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Serveur TanStack Start, scripts administratifs et Edge Functions : secrets.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
